GRYT_HOST=https://chat.example.com
# Required display name for this bot.
GRYT_NICKNAME=Assistant
GRYT_ALLOWED_CHANNEL_ID=
GRYT_IDENTITY_PATH=./data/gryt-bot-identity.json
# Editable prompt file, separate from identity and credentials.
SYSTEM_PROMPT_PATH=./prompts/system.md
# Optional single-use token for an administrator-created registration.
GRYT_BOT_TOKEN=

LLM_BASE_URL=https://llm.example.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_CONTEXT_TOKENS=8192
LLM_MAX_TOKENS=2048
# Allow two minutes for a slower local LLM, including requests with history.
LLM_TIMEOUT_MS=120000

# Optional web search. When enabled, start Compose with --profile search.
SEARCH_ENABLED=false
# Search query extraction inherits the main LLM API settings by default.
# Set these only to configure a separate OpenAI-compatible API/model.
SEARCH_LLM_BASE_URL=
SEARCH_LLM_API_KEY=
SEARCH_LLM_MODEL=
# Extraction is a tiny one-line task: short output budget and a short timeout
# so a stalled extraction degrades to "no search" quickly.
SEARCH_LLM_TIMEOUT_MS=8000
SEARCH_LLM_MAX_TOKENS=100
SEARCH_LLM_CONTEXT_TOKENS=8192
SEARCH_TIMEOUT_MS=10000
SEARCH_MAX_RESULTS=5
SEARCH_RATE_LIMIT=5
SEARCH_RATE_WINDOW_MS=60000
SEARCH_CACHE_TTL_MS=300000
