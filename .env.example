GRYT_HOST=https://chat.inferlo.xyz
GRYT_ALLOWED_CHANNEL_ID=
GRYT_IDENTITY_PATH=./data/gryt-bot-identity.json
# Optional single-use token for an administrator-created registration.
GRYT_BOT_TOKEN=

LLM_BASE_URL=https://api.v100console.skygroup.cloud/v1
LLM_MODEL=qwen3.8-27b
LLM_API_KEY=
LLM_CONTEXT_TOKENS=131000
LLM_MAX_TOKENS=2048
# Allow two minutes for a slower local LLM, including requests with history.
LLM_TIMEOUT_MS=120000

# Web search (optional). If SEARXNG_URL is empty, search is disabled.
SEARXNG_URL=http://searxng:8080
# Model that turns the user's message into a focused search query. Must be one
# of the three qwen3.8-27b-unleashed-{1,2,3} replicas (different from LLM_MODEL
# so the cheap extraction call does not compete for the answer's inference slot).
SEARCH_LLM_MODEL=
# Extraction is a tiny one-line task: short output budget and a short timeout
# so a stalled extraction degrades to "no search" quickly.
SEARCH_LLM_TIMEOUT_MS=8000
SEARCH_LLM_MAX_TOKENS=100
SEARCH_LLM_CONTEXT_TOKENS=8192
SEARCH_TIMEOUT_MS=10000
SEARCH_MAX_RESULTS=5
SEARCH_RATE_LIMIT=5
SEARCH_RATE_WINDOW_MS=60000
SEARCH_CACHE_TTL_MS=300000
